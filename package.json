{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o public/static/vendor/tw.css --minify"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}